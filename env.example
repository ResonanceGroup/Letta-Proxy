# Letta Proxy Environment Variables
# Copy this file to .env and fill in your actual values

# Letta Server Configuration
# Address of your Letta server URL (either local or cloud)
LETTA_BASE_URL=http://localhost:8283

# Letta API Key
# Required for authentication with Letta Cloud (leave blank if running local Letta server without auth)
LETTA_API_KEY=your_letta_api_key_here

# Letta Project Name
# Optional - defaults to "default-project"
LETTA_PROJECT=your-project-name

# Proxy Server Configuration
# IP address for the proxy server to bind to (default: 0.0.0.0)
PROXY_HOST=0.0.0.0

# Port for the proxy server to listen on (default: 8000)
PROXY_PORT=8000

# System Prompt Control
# Set to 'true' to omit system prompts from data sent to Letta agent
# Optional - defaults to "false"
# REMOVE_SYSTEM_PROMPT=false

# Output responses to a file for debugging
DEBUG_RAW_OUTPUT=false
